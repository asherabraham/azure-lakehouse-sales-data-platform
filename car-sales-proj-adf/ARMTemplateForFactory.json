			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_sql_db'"
		},
		"ls_adsl2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://carsalesproject23.dfs.core.windows.net/"
