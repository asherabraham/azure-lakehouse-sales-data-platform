{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "car-sales-proj-adf"
		},
		"dl_databricks_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'dl_databricks'"
		},
		"ls_adsl2_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adsl2'"
		},
		"ls_sql_db_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_sql_db'"
		},
		"ls_adsl2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://carsalesproject23.dfs.core.windows.net/"
		},
		"ls_github_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com/"
		},
		"ls_sql_db_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "car-sales-server.database.windows.net"
		},
		"ls_sql_db_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "car_sales_db"
		},
		"ls_sql_db_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "carsales"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "car-sales-proj-adf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"dl_databricks_accessToken": {
						"value": "[parameters('dl_databricks_accessToken')]"
					},
					"ls_adsl2_accountKey": {
						"value": "[parameters('ls_adsl2_accountKey')]"
					},
					"ls_sql_db_password": {
						"value": "[parameters('ls_sql_db_password')]"
					},
					"ls_adsl2_properties_typeProperties_url": {
						"value": "[parameters('ls_adsl2_properties_typeProperties_url')]"
					},
					"ls_github_properties_typeProperties_url": {
						"value": "[parameters('ls_github_properties_typeProperties_url')]"
					},
					"ls_sql_db_properties_typeProperties_server": {
						"value": "[parameters('ls_sql_db_properties_typeProperties_server')]"
					},
					"ls_sql_db_properties_typeProperties_database": {
						"value": "[parameters('ls_sql_db_properties_typeProperties_database')]"
					},
					"ls_sql_db_properties_typeProperties_userName": {
						"value": "[parameters('ls_sql_db_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}